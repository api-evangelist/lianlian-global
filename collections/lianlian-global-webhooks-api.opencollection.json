{
  "opencollection": "1.0.0",
  "info": {
    "name": "Distribution Account Webhooks API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Webhook Registration List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/webhooks"
          },
          "docs": "Get a list of webhook registrations of a client. If no registrations, empty list will be returned.\n\nReturn type is List<`Webhook`>"
        },
        {
          "info": {
            "name": "Register Webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/webhooks",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "*Register a webhook in LianLian Global's system. Registered webhook will be used to send events generated by LianLian Global's system.*<br>在连连国际系统中注册一个webhook。已注册的webhook将用于发送由连连国际系统生成的事件。\n\nReturn type is `Webhook` object."
        },
        {
          "info": {
            "name": "Get Webhook Registration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/webhooks/:webhookId",
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "*Get a webhook registration details by `webhookId`.*\n\nReturn type is `Webhook` object"
        },
        {
          "info": {
            "name": "Delete Webhook Registration",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/webhooks/:webhookId",
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "*Delete a webhook registration by `webhookId`.*"
        }
      ]
    }
  ],
  "bundled": true
}